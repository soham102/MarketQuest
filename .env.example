# MarketQuest — Supabase settings (copy to .env.local and fill in).
# Both values are public by design: access is enforced by Row Level Security.
# NEVER put the service_role / secret key or the Google client secret in this app.

# Supabase Dashboard → Project Settings → Data API → "Project URL"
NEXT_PUBLIC_SUPABASE_URL= 

# Supabase Dashboard → Project Settings → API Keys → "Publishable key" (sb_publishable_…)
# (Older projects: the legacy "anon public" key also works; you may set NEXT_PUBLIC_SUPABASE_ANON_KEY instead.)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
